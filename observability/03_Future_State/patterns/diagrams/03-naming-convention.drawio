        <mxCell id="c110" value="One structural change, four unchanged segments — minimal naming-system disruption." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="952" width="1670" height="24" as="geometry" /></mxCell>
