        <mxCell id="envBanner" value="⚠️  IMPORTANT — Why env is NOT in the stack name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontSize=14;fontStyle=1;fontColor=#92400E;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
