        <mxCell id="c89" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D97706;fillOpacity=100;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65.6" y="652" width="2.5" height="28" as="geometry" /></mxCell>
        <mxCell id="c90" value="" style="shape=triangle;direction=east;whiteSpace=wrap;html=1;fillColor=#D97706;fillOpacity=70;strokeColor=#D97706;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="67.0" y="654" width="18.2" height="14.0" as="geometry" /></mxCell>
        <mxCell id="c91" value="⚠  IMPORTANT — Why env is NOT in the stack name" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#D97706;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="648" width="1620" height="24" as="geometry" /></mxCell>
        <mxCell id="c92" value="In BOTH Pattern 005 AND Pattern 006, environment (Dev / Stage / Prod) is a telemetry LABEL — NOT a separate stack." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#0F1F3F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="684" width="1180" height="18" as="geometry" /></mxCell>
        <mxCell id="c93" value="✓  This label-based approach is what enables Pattern 006's native cross-tier views — Dev/Stage/Prod for the same BU coexist in one stack and are filtered logically at query time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="704" width="1180" height="18" as="geometry" /></mxCell>
        <mxCell id="c94" value="⚠  Common misconception:  &quot;env was removed in Pattern 006&quot;.  Reality: env was NEVER in the stack name — neither in 005 nor 006." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#D97706;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="728" width="1180" height="18" as="geometry" /></mxCell>
        <mxCell id="c95" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="678" width="410" height="78" as="geometry" /></mxCell>
        <mxCell id="c96" value="OPEN DISCUSSION" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#D97706;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="684" width="390" height="18" as="geometry" /></mxCell>
        <mxCell id="c97" value="Vladimir suggested 'Tier' instead of 'env'" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="704" width="390" height="18" as="geometry" /></mxCell>
        <mxCell id="c98" value="Position: stick with env (OTel standard)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#0F1F3F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="724" width="390" height="18" as="geometry" /></mxCell>
        <mxCell id="c99" value="→ deferred to live discussion" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#94A3B8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="738" width="390" height="14" as="geometry" /></mxCell>
