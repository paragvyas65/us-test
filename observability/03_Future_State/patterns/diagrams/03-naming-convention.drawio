        </mxCell>

        <mxCell id="envExplanation" value="In BOTH Pattern 005 AND Pattern 006, environment (Dev/Stage/Prod) is represented as a telemetry label (env=prod | stage | dev), NOT as a separate stack." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#0F2A47;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="1580" height="22" as="geometry" />
        </mxCell>
        <mxCell id="envBenefit" value="✓ This label-based approach is what enables Pattern 006&#39;s native cross-tier views — Dev/Stage/Prod for the same BU coexist in one stack and are filtered logically at query time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#0F4F2C;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="605" width="1580" height="22" as="geometry" />
        </mxCell>
        <mxCell id="envClarification" value="Common misconception: &quot;env was removed in Pattern 006.&quot;  Reality: env was NEVER in the stack name — neither in 005 nor 006." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#C0392B;spacingLeft=15;" vertex="1" parent="1">
