        <mxCell id="guarantee1Detail" value="Old per-product stacks remain fully operational throughout Phases 1-3. Teams continue using their existing dashboards and alerts. No forced cutover dates. Migration happens on a rolling basis per BU." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#0F2A47;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
