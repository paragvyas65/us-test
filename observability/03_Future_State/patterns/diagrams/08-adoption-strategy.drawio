        <mxCell id="guarantee4Detail" value="Each phase concludes with a stakeholder checkpoint. Vladimir, Johann, and BU leads confirm completion before next phase begins. CODEOWNERS gate all infrastructure changes. No surprise migrations." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#0F2A47;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
