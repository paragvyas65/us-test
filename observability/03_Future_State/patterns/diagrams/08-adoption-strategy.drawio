        <mxCell id="guarantee2Box" value="↩️ ROLLBACK CAPABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2A47;strokeColor=#0F2A47;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="500" y="715" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="guarantee2Detail" value="Through Phase 3, switching back to the old per-product stacks requires only routing changes — no data loss. Alloy collectors can revert to single-write. Old stacks retain full read/write capability until Phase 4 begins." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#0F2A47;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
