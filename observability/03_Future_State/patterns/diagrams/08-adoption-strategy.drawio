        </mxCell>
        <mxCell id="guarantee3Detail" value="Phase 2's dual-write enables side-by-side validation. Phase 3's parity checks confirm new stack data matches old. Team UAT and sign-off required before final cutover. No team forced into new state without verification." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#0F2A47;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
