        <mxCell id="prop2Box" value="📋 STANDARDIZED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2A47;strokeColor=#0F2A47;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="640" y="700" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="prop2Detail" value="Same workflow applies to all BUs — Lending, Payment, Universal Banking, TCM, Cornerstone. Identical validation rules, approval gates, and provisioning paths. Onboarding a new product follows the established pattern, not a bespoke process." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#0F2A47;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="745" width="520" height="65" as="geometry" />
        </mxCell>
        
        <mxCell id="prop3Box" value="🚀 SELF-SERVICE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2A47;strokeColor=#0F2A47;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1200" y="700" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="prop3Detail" value="Product teams operate within the rails — they create dashboards, define alerts, and request access via PR. No central team bottleneck. Platform team owns the rails (Terraform modules, validation logic), not the day-to-day changes." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#0F2A47;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="745" width="520" height="65" as="geometry" />
        </mxCell>
        
