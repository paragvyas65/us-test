        <mxCell id="prop1Detail" value="Every change is a PR with a CODEOWNER approval. Full git history shows who changed what, when, and why. Terraform Cloud retains audit logs of every plan and apply. Drift detection alerts on manual changes outside the GitOps flow." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#0F2A47;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
