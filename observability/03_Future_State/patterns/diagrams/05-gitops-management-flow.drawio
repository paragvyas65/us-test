                <mxCell id="c148" value="Two-tier model: Terraform manages infrastructure (slow, audited). Git Sync manages dashboards (fast, bidirectional)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" parent="1" vertex="1">
